{
    "manifest_version": 3,
    "name": "Sticky",
    "version": "1.0",
    "description": "A persistent sticky note for the browser.",
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Toggle Sticky"
    },
    "icons": {
        "128": "icon128.png"
    },
    "commands": {
        "toggle-sticky": {
            "suggested_key": {
                "default": "Alt+S"
            },
            "description": "Toggle Sticky"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["style.css", "home.html", "home.css", "home.js"],
            "matches": ["<all_urls>"]
        }
    ]
}